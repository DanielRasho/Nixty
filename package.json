{
  "name": "nixty-lib",
  "version": "0.1.1",
  "description": "A typed DSL for Nix: write your flake as TypeScript, emit a flake.nix.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    }
  },
  "bin": {
    "nixty": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/template.ts dist/template.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "nix",
    "nixos",
    "flake",
    "flake.nix",
    "dsl",
    "typescript",
    "cli"
  ],
  "author": "Daniel Rasho",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielRasho/Nixty.git"
  },
  "bugs": {
    "url": "https://github.com/DanielRasho/Nixty/issues"
  },
  "homepage": "https://github.com/DanielRasho/Nixty#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "typescript": "^7.0.2"
  }
}
